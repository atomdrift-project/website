---
layout: base.njk
title: Compare
permalink: /compare/
description: How malware scanners compare on real supply-chain attacks — detection rate and false positives, measured against fresh, ground-truth-labelled packages.
---

<style>
  .compare { max-width: 1000px; margin: 0 auto; padding: 4px 24px 64px; }

  /* hero */
  .cmp-hero { padding: 14px 0 6px; }
  .cmp-hero h1 { font-family: 'Oxanium', sans-serif; font-size: 2.15rem; font-weight: 800;
                 color: var(--carbon); letter-spacing: -0.6px; line-height: 1.05; margin: 0; }
  .cmp-hero h1 .accent { color: var(--atomdrift-blue); }
  .cmp-hero .stripe { height: 4px; width: 72px; border-radius: 2px; margin: 12px 0 16px;
                      background: linear-gradient(90deg, var(--toxic) 0%, var(--toxic-muted) 60%, transparent 100%); }
  .cmp-hero .lede { color: var(--graphite); max-width: none; line-height: 1.6; font-size: 1.02rem; }
  .cmp-hero .brief { color: #166534; font-size: 1.12rem; font-weight: 500; line-height: 1.5; }
  .cmp-hero .brief b { color: #166534; font-weight: 800; }
  .cmp-hero .brief a { color: #166534; text-decoration: underline; text-underline-offset: 2px; }
  .cmp-hero .lede b { color: var(--carbon); }
  .cmp-meta { color: var(--slate); font-size: .78rem; line-height: 1.65; margin: 10px 0 0;
              border-top: 1px solid var(--border); padding-top: 9px; }
  .cmp-meta b { color: var(--iron); font-weight: 700; }
  .cmp-meta a { color: var(--slate); }

  /* section headings (mirror .content h2) */
  .compare h2 { font-family: 'Oxanium', sans-serif; font-size: 1.2rem; font-weight: 700; color: var(--carbon);
                border-bottom: 1px solid var(--border); padding-bottom: 6px; margin: 44px 0 4px; letter-spacing: -0.3px; }
  .compare .sub { color: var(--slate); font-size: .85rem; margin: 0 0 16px; }

  /* outcome colors: green = scanner did the right thing, red = wrong
     (errored on detection counts as a miss), light grey = can't scan.
     --t-* keep the raw severity colors used by the audit table. */
  :root {
    --t-hostile: #dc2626; --t-suspicious: #e0a526; --t-benign: #2f9e63; --t-nodata: #7b8494; --t-unsupported: #b6bcc6;
    --g-good: #b5d400; --g-good-weak: #e3efab; --g-bad: #e5484d; --g-bad-weak: #f4b4b6; --g-na: #cdd2da;
  }
  .legend { display: flex; gap: 8px 20px; flex-wrap: wrap; align-items: center; font-size: .8rem; color: var(--iron); margin: 14px 0 4px; }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 11px; height: 11px; border-radius: 2px; display: inline-block; }
  .legend-note { color: var(--slate); font-size: .76rem; font-style: italic; }
  .sw-hostile { background: var(--g-good); } .sw-suspicious { background: var(--g-good-weak); }
  .sw-errored { background: var(--g-bad); } .sw-unsupported { background: var(--t-unsupported); }

  /* comparison table */
  .cmp-table { width: 100%; border-collapse: collapse; margin: 16px 0 6px; font-size: .92rem; }
  .cmp-table th { font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: var(--slate);
                  font-weight: 600; text-align: left; padding: 8px 12px; border-bottom: 2px solid var(--border); }
  .cmp-table td { padding: 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .cmp-table tr:hover td { background: var(--cream); }
  .cmp-table tr.us-row td { background: var(--toxic-dim); }
  .cmp-table tr.us-row:hover td { background: var(--toxic-dim); }
  .cmp-table td.num { text-align: right; font-variant-numeric: tabular-nums; font-weight: 700; }
  .cmp-table .na { color: var(--slate); font-weight: 400; }
  .cmp-table .prov { font-family: 'Oxanium', sans-serif; font-weight: 700; font-size: .98rem; }
  .cmp-table .prov.us { color: var(--atomdrift-blue); }
  .cmp-table .good { color: var(--t-benign); } .cmp-table .bad { color: var(--t-hostile); }

  /* stacked bars */
  .bench { display: grid; grid-template-columns: max-content 1fr 66px; gap: 9px 14px; align-items: center; margin: 9px 0; }
  .bench .rname { font-family: 'Oxanium', sans-serif; font-weight: 600; font-size: .9rem; color: var(--carbon); white-space: nowrap; }
  .bench .rname.us { color: var(--atomdrift-blue); }
  .bench .rpct { text-align: right; font-variant-numeric: tabular-nums; font-weight: 700; font-size: .9rem; color: var(--carbon); line-height: 1.1; }
  .bench .rpct.neg { color: var(--g-bad); }
  .bar { display: flex; height: 24px; border-radius: 5px; overflow: hidden; background: var(--mist);
         box-shadow: inset 0 0 0 1px rgba(0,0,0,.05); }
  .bar .seg { height: 100%; }
  .bar .seg-hostile { background: var(--g-good); }        /* flagged hostile */
  .bar .seg-suspicious { background: var(--g-good-weak); } /* flagged suspicious */
  .bar .seg-errored { background: var(--g-bad); }          /* scanner failed — counts as a miss (detection) */
  .bar .seg-unsupported { background: var(--t-unsupported); } /* can't scan: unsupported ecosystem/file type */
  .bar .seg-cov { background: var(--g-good); }             /* capability coverage */

  /* per-ecosystem cards */
  .eco-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px 26px; margin-top: 16px; }
  .eco-card { background: var(--cream); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; transition: box-shadow .2s; }
  .eco-card:hover { box-shadow: -3px 0 0 0 var(--toxic), 0 1px 3px rgba(0,0,0,.06); }
  .eco-card h4 { font-family: 'Oxanium', sans-serif; margin: 0 0 8px; font-size: .82rem; text-transform: uppercase;
                 letter-spacing: .04em; color: var(--iron); }

  .note { background: var(--cream); border: 1px solid var(--border); border-left: 3px solid var(--toxic-muted);
          border-radius: 6px; padding: 12px 16px; font-size: .85rem; color: var(--graphite); margin: 18px 0; }
  details.method { margin-top: 40px; font-size: .88rem; color: var(--graphite); }
  details.method > summary { cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: 9px;
    font-family: 'Oxanium', sans-serif; font-weight: 700; font-size: 1rem; color: var(--carbon); padding: 6px 0; }
  details.method > summary::-webkit-details-marker { display: none; }
  details.method > summary::before { content: "▸"; color: var(--toxic-dark); font-size: .8rem; transition: transform .15s ease; }
  details.method[open] > summary::before { transform: rotate(90deg); }
  details.method > summary:hover { color: var(--atomdrift-blue); }
  details.method .method-body { margin: 4px 0 0 12px; padding: 14px 20px 16px;
    background: var(--cream); border-left: 3px solid var(--toxic); border-radius: 0 8px 8px 0; }
  details.method .method-body ul { margin: 0; padding-left: 20px; }
  .method-versions { margin: 12px 0 0; font-size: .82rem; }
  details.method li { margin: 9px 0; line-height: 1.6; }
  details.method li::marker { color: var(--toxic-dark); }
  details.method strong { color: var(--carbon); }
  details.method em { font-style: normal; font-weight: 600; color: var(--graphite); }

  /* feature matrix: ✓/✗ capability cells + registry count (list on hover) */
  .feature-table th.ctr, .feature-table td.feat, .feature-table td.regs { text-align: center; }
  .feature-table td.feat { font-size: 1.05rem; line-height: 1; }
  .feature-table .yes { color: var(--toxic-dark); font-weight: 800; }
  .feature-table .no { color: var(--g-na); font-weight: 700; }
  .reg-count { font-family: 'Oxanium', sans-serif; font-weight: 800; font-variant-numeric: tabular-nums;
               color: var(--carbon); font-size: 1rem; cursor: help; border-bottom: 1px dotted var(--slate); }
  .feature-table tr.us-row .reg-count { color: var(--atomdrift-blue); }

  /* reference-data audit */
  details.audit { margin-top: 32px; }
  details.audit > summary { cursor: pointer; font-family: 'Oxanium', sans-serif; font-weight: 700; color: var(--carbon); padding: 6px 0; }
  .audit-h { font-family: 'Oxanium', sans-serif; margin: 22px 0 2px; font-size: .92rem; color: var(--carbon); }
  .audit-note { font-weight: 400; color: var(--slate); font-size: .78rem; }
  .trend-wrap { position: relative; height: 340px; margin-top: 8px; }
  .audit-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 8px; margin-top: 10px; }
  .audit-table { width: 100%; border-collapse: collapse; font-size: .78rem; }
  .audit-table th, .audit-table td { padding: 6px 9px; border-bottom: 1px solid var(--border); text-align: left; white-space: nowrap; }
  .audit-table thead th { background: var(--cream); font-size: .66rem; text-transform: uppercase; letter-spacing: .03em; color: var(--slate); }
  .audit-table tr:last-child td { border-bottom: none; }
  .audit-table .mono { font-family: 'SF Mono', Consolas, monospace; }
  .audit-table a { color: var(--atomdrift-blue); text-decoration: none; }
  .audit-table a:hover { text-decoration: underline; }
  .lab-bad { color: var(--t-hostile); font-weight: 600; } .lab-good { color: var(--t-benign); } .lab-unknown { color: var(--slate); }
  .tier-hostile { background: rgba(220,38,38,.12); color: #991b1b; font-weight: 700; text-align: center; }
  .tier-suspicious { background: rgba(224,165,38,.18); color: #854d0e; font-weight: 700; text-align: center; }
  .tier-benign { background: rgba(47,158,99,.13); color: #166534; text-align: center; }
  .tier-nodata { background: rgba(123,132,148,.18); color: var(--slate); font-weight: 600; text-align: center; }
  .tier-unsupported { background: var(--mist); color: var(--slate); text-align: center; }
  .tier-na { color: var(--g-na); text-align: center; font-weight: 600; }

  /* headline scoreboard — the one result a skimmer should leave with */
  .scoreboard { display: flex; gap: 24px; align-items: center; flex-wrap: wrap;
    background: var(--carbon); color: #fff; border-radius: 12px; padding: 22px 26px; margin: 20px 0 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,.14); }
  .scoreboard .score-num { font-family: 'Oxanium', sans-serif; font-weight: 800; font-size: 4.4rem;
    line-height: .85; color: var(--toxic); letter-spacing: -2px; }
  .scoreboard .score-num .pct { font-size: 2.2rem; letter-spacing: -1px; }
  .scoreboard .score-body { flex: 1 1 360px; }
  .scoreboard .score-lead { font-size: 1.04rem; line-height: 1.5; margin: 0 0 9px; color: #eef0f3; }
  .scoreboard .score-lead b { color: var(--toxic); }
  .scoreboard .score-diff { font-size: .85rem; line-height: 1.55; margin: 0; color: #b9bfc9; }
  .scoreboard .score-diff b { color: #eef0f3; font-weight: 700; }
  .scoreboard .score-diff a { color: #fff; text-decoration: underline; text-underline-offset: 2px; }

  /* calls to action */
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 2px 0 6px; }
  .cta { display: inline-flex; align-items: center; font-family: 'Oxanium', sans-serif; font-weight: 700;
    font-size: .92rem; padding: 10px 18px; border-radius: 7px; text-decoration: none;
    border: 1.5px solid var(--border); color: var(--carbon); transition: border-color .15s, color .15s, background .15s; }
  .cta:hover { border-color: var(--atomdrift-blue); color: var(--atomdrift-blue); }
  .cta-primary { background: var(--toxic); border-color: var(--toxic); color: var(--carbon); }
  .cta-primary:hover { background: var(--toxic-dark); border-color: var(--toxic-dark); color: #fff; }

  /* catch-rate / false-alarm quadrant. Geometry and label placement are computed
     in the `quadrant` filter; this only styles what it emits. */
  .frontier-wrap { margin: 14px 0 4px; }
  .frontier-wrap svg { width: 100%; height: auto; display: block; }
  .q-grid { stroke: var(--border); stroke-width: 1; }
  .q-axis { stroke: var(--slate); stroke-width: 1.25; }
  .q-div { stroke: var(--slate); stroke-width: 1; stroke-dasharray: 5 5; opacity: .45; }
  .q-tick { fill: var(--slate); font-size: 11px; font-family: system-ui, sans-serif; }
  .q-alab { fill: var(--iron); font-size: 12.5px; font-weight: 600; font-family: 'Oxanium', sans-serif; }
  .q-target { fill: var(--g-good); opacity: .08; }
  .q-quad { fill: var(--slate); opacity: .62; font-size: 11px; font-weight: 700; letter-spacing: .09em;
            text-transform: uppercase; font-family: 'Oxanium', sans-serif; }
  .q-quad.on-target { fill: var(--t-benign); opacity: .85; }
  .q-leader { stroke: var(--slate); stroke-width: 1; opacity: .45; }
  .q-pt { stroke: #fff; stroke-width: 2; }
  .q-count { fill: #fff; font-size: 11.5px; font-weight: 800; font-family: 'Oxanium', sans-serif; }
  .q-halo { opacity: .15; }
  .q-swatch { rx: 1.5; }
  .q-name { fill: var(--carbon); font-size: 12.5px; font-weight: 600; font-family: 'Oxanium', sans-serif; }
  .q-name.us { font-weight: 800; }
  .q-val { fill: var(--slate); font-size: 10.5px; font-weight: 500; font-family: system-ui, sans-serif; }

  /* figure notes — the source-and-sample-size line every chart carries */
  .fig-note { color: var(--slate); font-size: .76rem; line-height: 1.5; margin: 6px 0 0; }
  .fig-note a { color: var(--slate); }
</style>

{# Bars show what each engine flagged, as a share of the cohort: green = hostile,
   light green = suspicious, anchored left. Anchored right: on detection bars
   (kind 'bad' and the per-ecosystem cards) a red share is samples the engine
   errored on — still a miss, and the mouseover names each failure — followed by
   a light-grey share for what it can't scan at all. Every bar carries that grey
   tail, because the denominator is the whole cohort for every engine (see
   battle.go: a skip is a non-catch, not an exemption); on the known-good bars it
   marks the stretch that is untested rather than earned. The clear middle is the
   affirmatively-analyzed all-clear. On known-bad the fill is the catch rate
   (more is better); on known-good it's the false-alarm rate (less is better). #}
{%- macro bar(s, kind) -%}
  {%- set nodata = s.nodata or 0 -%}
  {%- set errored = s.errored or 0 -%}
  <div class="bar" title="{{ s.hostile }} hostile · {{ s.suspicious }} suspicious · {{ s.benign }} analyzed clean{% if nodata %} · {{ nodata }} no data (couldn't confirm){% endif %}{% if errored %} · {{ errored }} errored{% if kind != 'good' %} (counts as a miss){% endif %}{% endif %}{% if s.unsupported %} · {{ s.unsupported }} can't scan{% endif %}">
    {%- if s.supported > 0 -%}
      {%- if s.hostile > 0 %}<span class="seg seg-hostile" style="width:{{ s.hostile / s.supported * 100 }}%"></span>{% endif -%}
      {%- if s.suspicious > 0 %}<span class="seg seg-suspicious" style="width:{{ s.suspicious / s.supported * 100 }}%"></span>{% endif -%}
      {%- if kind != 'good' and errored > 0 -%}
        {%- set errs = battle.samples | errorLines(s.scanner, 'bad') if kind == 'bad' else [] -%}
        <span class="seg seg-errored" style="width:{{ errored / s.supported * 100 }}%; margin-left:auto" title="{{ errored }} errored (counts as a miss){% if errs | length %}:{{ '\n' }}{{ errs | join('\n') }}{% endif %}"></span>
      {%- endif -%}
      {%- if s.unsupported > 0 %}<span class="seg seg-unsupported" style="width:{{ s.unsupported / s.supported * 100 }}%{% if not (kind != 'good' and errored > 0) %}; margin-left:auto{% endif %}" title="{{ s.unsupported }} — provider does not support this registry or file type{% if kind != 'good' %}; scored as a miss{% endif %}"></span>{% endif -%}
    {%- endif -%}
  </div>
{%- endmacro -%}

{# The number is the flagged rate (hostile + suspicious) over what the engine
   could scan — so it always matches the bar's fill. #}
{%- macro benchRows(board, kind) -%}
  <div class="bench">
  {%- for s in board | byFlagged %}
    {%- set p = providers[s.scanner] %}
    <div class="rname{% if s.scanner == 'ascan' %} us{% endif %}">{{ p.name or s.scanner }}</div>
    {{ bar(s, kind) }}
    {%- if s.supported %}
    <div class="rpct">{{ (100 * (s.hostile + s.suspicious) / s.supported) | round(0) }}%</div>
    {%- else %}
    <div class="rpct" style="color:var(--slate)">—</div>
    {%- endif %}
  {%- endfor %}
  </div>
{%- endmacro -%}

{%- macro auditTable(samples, board) -%}
  <div class="audit-wrap">
    <table class="audit-table">
      <thead>
        <tr>
          <th>Package</th>
          {%- for s in board %}<th>{{ providers[s.scanner].name or s.scanner }}</th>{%- endfor %}
        </tr>
      </thead>
      <tbody>
        {%- for sm in samples %}
        <tr>
          <td><a href="https://lab.atomdrift.org/file/{{ sm.sha256 }}" title="{{ sm.filename }}{% if sm.ecosystem %} · {{ sm.ecosystem }}{% endif %} — view in Atomdrift Lab">{{ sm.purl or sm.filename }}</a></td>
          {%- for s in board %}
            {%- set v = sm.verdicts | find("scanner", s.scanner) %}
            {%- if v and v.tier != 'unsupported' %}
            <td class="tier-{{ v.tier }}" title="{{ v.tier }}{% if v.detail %} — {{ v.detail }}{% endif %}">{{ v.tier | first | upper }}</td>
            {%- else %}
            <td class="tier-na" title="not supported{% if v and v.detail %} — {{ v.detail }}{% endif %}">-</td>
            {%- endif %}
          {%- endfor %}
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </div>
{%- endmacro -%}

<div class="main-full compare">

  <div class="cmp-hero">
    <h1>Malware Scanner <span class="accent">Battle Royale</span></h1>
    <div class="stripe"></div>
    {%- set h = battle | headline %}
    <p class="lede brief">
      {%- if h %}
      As of {{ battle.generated_at | dateDisplay }},
      <a href="/scan/">Atomdrift</a> catches <b>{{ h.detRate }}%</b> of
      zero-day malware —
      {% if h.lead and h.lead >= 1.5 %}<b>{{ h.lead | round(1) }}×</b>{% else %}<b>{{ h.leadPts }} points</b> clear of{% endif %}
      the next-best engine{% if h.bestName %}, {{ providers[h.bestName].name or h.bestName }} at {{ h.bestDet }}%{% endif %}.
      {%- else %}
      Catching tomorrow's supply-chain malware — before the feeds catch up —
      is the whole game <a href="/scan/">atomscan</a> plays.
      {%- endif %}
    </p>
    <p class="cmp-meta">
      {{ battle.detection.leaderboard | length }} engines · n&nbsp;=&nbsp;{{ battle.detection.sample_count }} known-malware, {{ battle.false_positive.sample_count }} presumed-good ·
      rebuilt from live feeds every night · <a href="#methodology">methodology</a>
      <br><b>Disclosure:</b> this benchmark is run and published by the Atomdrift project, which is one of the engines measured.
      Every sample, verdict and rate is published below so anyone can check the scoring.
    </p>
  </div>

  {# Scoreboard + CTAs hidden pending rework — remove this comment marker and the closing one below to re-enable.
  {%- set h = battle | headline %}
  {%- if h %}
  <div class="scoreboard">
    <div class="score-num">{{ h.detRate }}<span class="pct">%</span></div>
    <div class="score-body">
      <p class="score-lead">of this run's {{ h.sampleCount }} zero-day samples caught —
        {% if h.lead and h.lead >= 1.5 %}<b>{{ h.lead | round(1) }}×</b> the next-best engine{% else %}<b>{{ h.leadPts }} points</b> clear of the next-best engine{% endif %}
        ({{ providers[h.bestName].name or h.bestName }}, {{ h.bestDet }}%){% if h.fpRate != null %}, while crying wolf on just {{ h.fpRate }}% of clean packages{% endif %}.</p>
      <p class="score-diff"><b>Zero detection lag.</b> No feed to poll, no vendor verdict to wait on, no cloud round-trip —
        <a href="/scan/">atomscan</a> decides locally and autonomously, the moment a package lands.</p>
    </div>
  </div>
  <div class="cta-row">
    <a class="cta cta-primary" href="/scan/">Point it at your dependencies →</a>
    <a class="cta" href="/scan/how-it-works/">How it works</a>
  </div>
  {%- endif %}
  #}

  <h2 id="capabilities">What each engine is built to scan</h2>
  <p class="sub">Capabilities as documented by each vendor — the ground the benchmark is run on.</p>
  <table class="cmp-table feature-table">
    <thead>
      <tr>
        <th>Provider</th><th>License&nbsp;/&nbsp;access</th>
        <th class="ctr" title="Scans your own first-party application source">App&nbsp;code</th>
        <th class="ctr" title="Catches malware in code vendored/bundled into a package — not just declared dependencies">Vendored&nbsp;code</th>
        <th class="ctr" title="Resolves and checks a package's declared dependencies">Dependencies</th>
        <th class="ctr" title="Scans compiled binaries">Binaries</th>
        <th class="ctr" title="Runs fully offline — no cloud service required">Air-gap</th>
        <th class="ctr" title="Package registries with coverage — hover for the list">Registries</th>
      </tr>
    </thead>
    <tbody>
      {%- for p in providers | byRegistries %}
        {%- set key = p.key %}
        <tr{% if key == 'ascan' %} class="us-row"{% endif %}>
          <td class="prov{% if key == 'ascan' %} us{% endif %}">{{ p.name or key }}</td>
          <td{% if p.license_note %} title="{{ p.license_note }}"{% endif %}>{{ p.license or "—" }}{% if p.license_note %}<span class="lic-note">*</span>{% endif %}</td>
          <td class="feat">{% if p.appcode %}<span class="yes" title="yes">✓</span>{% else %}<span class="no" title="no">✗</span>{% endif %}</td>
          <td class="feat">{% if p.vendored %}<span class="yes" title="yes">✓</span>{% else %}<span class="no" title="no">✗</span>{% endif %}</td>
          <td class="feat">{% if p.deps %}<span class="yes" title="yes">✓</span>{% else %}<span class="no" title="no">✗</span>{% endif %}</td>
          <td class="feat">{% if p.binaries %}<span class="yes" title="yes">✓</span>{% else %}<span class="no" title="no">✗</span>{% endif %}</td>
          <td class="feat">{% if p.airgap %}<span class="yes" title="yes">✓</span>{% else %}<span class="no" title="no">✗</span>{% endif %}</td>
          <td class="regs">{% if p.registries | length %}<span class="reg-count" title="{{ p.registries | join(' · ') }}">{{ p.registries | length }}</span>{% else %}<span class="no" title="{{ p.registries_note or 'no registry coverage' }}">n/a</span>{% endif %}</td>
        </tr>
      {%- endfor %}
    </tbody>
  </table>
  <p class="fig-note">Table 1 — Engine capabilities. <b>Registries</b> counts the package registries an engine resolves; <em>n/a</em> marks the engines that work on files rather than packages (hover a cell for the detail). <span class="lic-note">*</span> hover for the access tier measured here.</p>

  <h2 id="detection">Zero-day detection</h2>
  <p class="sub">Catch rate on {{ battle.detection.sample_count }} freshly-published malware packages, pulled live from <a href="https://osv.dev/list?ecosystem=&q=MAL" target="_blank" rel="noopener">OSV</a>, <a href="https://opensourcemalware.com/" target="_blank" rel="noopener">OSM</a>, and other threat feeds.</p>
  <div class="legend">
    <span><i class="sw-hostile"></i> Flagged hostile</span>
    <span><i class="sw-suspicious"></i> Flagged suspicious</span>
    {%- if battle.detection.leaderboard | selectattr("errored") | length %}
    <span><i class="sw-errored"></i> Errored (counts as a miss)</span>
    {%- endif %}
    <span><i class="sw-unsupported"></i> Couldn't scan — out of the engine's scope (counts as a miss)</span>
  </div>
  {{ benchRows(battle.detection.leaderboard, 'bad') }}
  <p class="fig-note">Fig. 1 — Share of {{ battle.detection.sample_count }} known-malware samples flagged, all {{ battle.detection.leaderboard | length }} engines, {{ battle.generated_at | dateDisplay }}. Every engine is scored over the same cohort: a sample it can't scan is a miss, not an exemption — the grey tail shows how much of the cohort that is, and Fig. 2 measures that scope directly.</p>

  <h2 id="coverage">Coverage — what each engine can scan</h2>
  <p class="sub">Share of this run's files each engine can even analyze — coverage, not detection.</p>
  <div class="bench">
  {%- for c in battle.samples | coverageBoard(providers, battle.ascan_types, battle.detection.leaderboard) %}
    <div class="rname{% if c.scanner == 'ascan' %} us{% endif %}">{{ c.name }}</div>
    <div class="bar" title="{{ c.supported }} of {{ c.total }} files{% if c.uncovered | length %} · can't scan: {{ c.uncovered | join(', ') }}{% endif %}">
      {%- if c.rate > 0 %}<span class="seg seg-cov" style="width:{{ c.rate * 100 }}%"></span>{% endif -%}
    </div>
    <div class="rpct">{{ (c.rate * 100) | round(0) }}%</div>
  {%- endfor %}
  </div>
  <p class="fig-note">Fig. 2 — Files in this run's samples each engine can analyze, from its declared registry and file-type support. Hover a bar for what it skips. Hash-based engines take any file, so they cover everything the run contains.</p>

  <h2 id="false-positives">False positives — flagged good packages</h2>
  {%- if battle.false_positive.sample_count > 0 %}
  <p class="sub">Across {{ battle.false_positive.sample_count }} presumed-good packages — any flag is a false alarm. The grey tail is what an engine can't scan, so that stretch is untested, not earned.</p>
  <div class="legend">
    <span><i class="sw-hostile"></i> Flagged hostile</span>
    <span><i class="sw-suspicious"></i> Flagged suspicious</span>
    <span><i class="sw-unsupported"></i> Couldn't scan — out of the engine's scope (untested, not earned)</span>
  </div>
  {{ benchRows(battle.false_positive.leaderboard, 'good') }}
  <p class="fig-note">Fig. 3 — Share of {{ battle.false_positive.sample_count }} presumed-good packages each engine flagged, over the same cohort.{% if battle.false_positive.sample_count < 20 %} A cohort this small resolves false alarms coarsely — one flag moves an engine by {{ (100 / battle.false_positive.sample_count) | round(0) }} points; read it as a floor, not a precise rate.{% endif %} Flags here are re-adjudicated as feeds catch up (see methodology).</p>
  {%- else %}
  <p class="sub">No known-good packages were pulled this run, so there's nothing to measure false positives against.</p>
  <div class="note">No known-good samples in this run — false-positive rates are <em>undefined</em>, not zero. An engine shows 0% here only when it was actually tested on good packages and flagged none; this panel returns with the next run that includes a good cohort.</div>
  {%- endif %}

  {%- set q = battle | quadrant(providers) %}
  {%- if q %}
  <h2>Catch rate vs. false alarms</h2>
  <p class="sub">Flag everything and you win on detection; flag nothing and you win on false positives. Only the top-right corner is worth anything — catch the malware, spare the clean code.</p>
  <div class="frontier-wrap">
    <svg viewBox="0 0 {{ q.w }} {{ q.h }}" role="img" aria-label="Catch rate against false-alarm rate for every engine measured this run. The horizontal axis is catch rate, higher to the right; the vertical axis is false-alarm rate, inverted so fewer false alarms is higher. Per-engine figures are listed in the reference tables below.">
      <!-- target quadrant: high catch, few false alarms -->
      <rect class="q-target" x="{{ q.xDiv }}" y="{{ q.pt }}" width="{{ q.pr - q.xDiv }}" height="{{ q.yDiv - q.pt }}"></rect>
      <!-- gridlines -->
      {%- for t in q.xTicks %}
      <line class="q-grid" x1="{{ t.x }}" y1="{{ q.pt }}" x2="{{ t.x }}" y2="{{ q.pb }}"></line>
      <text class="q-tick" x="{{ t.x }}" y="{{ q.pb + 19 }}" text-anchor="middle">{{ t.v }}%</text>
      {%- endfor %}
      {%- for t in q.yTicks %}
      <line class="q-grid" x1="{{ q.pl }}" y1="{{ t.y }}" x2="{{ q.pr }}" y2="{{ t.y }}"></line>
      <text class="q-tick" x="{{ q.pl - 10 }}" y="{{ t.y + 4 }}" text-anchor="end">{{ t.v }}%</text>
      {%- endfor %}
      <!-- quadrant dividers + captions -->
      <line class="q-div" x1="{{ q.xDiv }}" y1="{{ q.pt }}" x2="{{ q.xDiv }}" y2="{{ q.pb }}"></line>
      <line class="q-div" x1="{{ q.pl }}" y1="{{ q.yDiv }}" x2="{{ q.pr }}" y2="{{ q.yDiv }}"></line>
      <text class="q-quad" x="{{ q.pl + 10 }}" y="{{ q.pt + 20 }}">Conservative</text>
      <text class="q-quad on-target" x="{{ q.pr - 10 }}" y="{{ q.pt + 20 }}" text-anchor="end">Precise</text>
      <text class="q-quad" x="{{ q.pl + 10 }}" y="{{ q.pb - 10 }}">Trailing</text>
      <text class="q-quad" x="{{ q.pr - 10 }}" y="{{ q.pb - 10 }}" text-anchor="end">Aggressive</text>
      <!-- axes -->
      <line class="q-axis" x1="{{ q.pl }}" y1="{{ q.pt }}" x2="{{ q.pl }}" y2="{{ q.pb }}"></line>
      <line class="q-axis" x1="{{ q.pl }}" y1="{{ q.pb }}" x2="{{ q.pr }}" y2="{{ q.pb }}"></line>
      <text class="q-alab" x="{{ (q.pl + q.pr) / 2 }}" y="{{ q.pb + 46 }}" text-anchor="middle">Catch rate on known malware  ·  higher is better →</text>
      <text class="q-alab" transform="translate(18,{{ (q.pt + q.pb) / 2 }}) rotate(-90)" text-anchor="middle">False alarms on clean packages  ·  fewer is better ↑</text>
      <!-- engines: one marker per distinct result, labelled clear of its neighbours -->
      {%- for g in q.groups %}
      {%- if g.leader %}<line class="q-leader" x1="{{ g.leader.x1 }}" y1="{{ g.leader.y1 }}" x2="{{ g.leader.x2 }}" y2="{{ g.leader.y2 }}"></line>{% endif %}
      {%- if g.us %}<circle class="q-halo" cx="{{ g.x }}" cy="{{ g.y }}" r="17" fill="{{ g.color }}"></circle>{% endif %}
      <circle class="q-pt" cx="{{ g.x }}" cy="{{ g.y }}" r="{{ g.r }}" fill="{{ g.color }}">
        <title>{% for e in g.engines %}{{ e.name }}{% if not loop.last %}, {% endif %}{% endfor %} — {{ g.value }}</title>
      </circle>
      {%- if g.n > 1 %}<text class="q-count" x="{{ g.x }}" y="{{ g.y + 4 }}" text-anchor="middle">{{ g.n }}</text>{% endif %}
      {%- for e in g.engines %}
      {%- set ly = g.label.y + (loop.index0 * q.lineH) + 11 %}
      {%- if g.n > 1 %}
      {%- set sx = (g.label.tx - 9) if g.label.anchor == 'end' else (g.label.x if g.label.anchor == 'start' else g.label.tx - (e.name | length * 3.7) - 13) %}
      <rect class="q-swatch" x="{{ sx }}" y="{{ ly - 8 }}" width="8" height="8" fill="{{ e.color }}"></rect>
      {%- endif %}
      {%- set nx = (g.label.tx - 15 if g.n > 1 else g.label.tx) if g.label.anchor == 'end' else (g.label.x + 14 if g.n > 1 else g.label.x) %}
      <text class="q-name{% if e.us %} us{% endif %}" x="{{ g.label.tx if g.label.anchor == 'middle' else nx }}" y="{{ ly }}" text-anchor="{{ g.label.anchor }}">{{ e.name }}</text>
      {%- endfor %}
      <text class="q-val" x="{{ g.label.tx }}" y="{{ g.label.y + (g.engines | length * q.lineH) + 11 }}" text-anchor="{{ g.label.anchor }}">{{ g.value }}</text>
      {%- endfor %}
    </svg>
  </div>
  <p class="fig-note">Fig. 4 — Catch rate on {{ battle.detection.sample_count }} known-malware samples against false alarms on {{ battle.false_positive.sample_count }} presumed-good packages, {{ battle.generated_at | dateDisplay }}. The false-alarm axis is inverted — 0% at the top — so up and to the right is better. Engines with identical results share one numbered marker. Quadrant boundaries are fixed at {{ q.xDivVal }}% catch and {{ q.yDivVal }}% false alarms.</p>
  {%- endif %}

  <h2 id="by-ecosystem">Detection by ecosystem</h2>
  <p class="sub">Catch rate within each ecosystem, over the samples each engine can scan there.</p>
  <div class="eco-grid">
    {%- for e in battle.detection.by_ecosystem | byEcoSize %}
      <div class="eco-card">
        <h4>{{ e.eco }} <span class="audit-note">{{ e.n }} sample{{ "s" if e.n != 1 }}</span></h4>
        {{ benchRows(e.board, 'eco') }}
      </div>
    {%- endfor %}
  </div>
  <p class="fig-note">Fig. 5 — The same {{ battle.detection.sample_count }} samples split by ecosystem. Cohorts this small are indicative, not conclusive; the sample count is on each card.</p>

  <h2 id="over-time">Zero-day detection over time</h2>
  <p class="sub">Each engine's catch rate, run over run, on malware this fresh:{% if battle.malware_age %} {{ battle.malware_age.min_hours | round(0) }}h youngest, {{ battle.malware_age.mean_hours | round(0) }}h mean, {{ battle.malware_age.max_hours | round(0) }}h oldest{% else %} pulled straight from live threat feeds{% endif %}.</p>
  {%- if history and history | length >= 2 %}
  <div class="trend-wrap"><canvas id="trendChart"></canvas></div>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script>
  (function () {
    // Truncate to the 2026-07-09 10:00 UTC pipeline overhaul: earlier runs measured a
    // materially different detection stack, so plotting them would misrepresent the
    // current engines. Non-destructive — history.json keeps every point.
    const CUTOFF = Date.parse('2026-07-09T10:00:00Z');
    const H = ({{ history | dump | safe }}).filter(p => Date.parse(p.at) >= CUTOFF);
    const PROV = {{ providers | dump | safe }};
    // Engine colors and draw order come from providers.json — one declaration
    // shared with the quadrant, so an engine keeps its hue across the page and
    // no engine can be missing from this chart just by being absent from a map
    // hardcoded here.
    const ENGINES = Object.keys(PROV).filter(e => !PROV[e].hidden)
      .sort((a, b) => (PROV[a].slot || 99) - (PROV[b].slot || 99));
    const COLOR = Object.fromEntries(ENGINES.map(e => [e, PROV[e].color || '#6b7280']));
    const US = 'ascan';
    const labels = H.map(p => new Date(p.at).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric' }));
    // Atomdrift is the subject: drawn last (on top) and heavier than the field.
    // The emphasis is weight only — fading the others toward the surface used to
    // collapse them into each other (seven lines at 45% alpha sit ~7 ΔE apart,
    // under the ~15 a full-color reader needs), so every line keeps its own hue.
    const order = ENGINES.filter(e => e !== US).concat(US);
    const datasets = order.map(e => {
      const us = e === US;
      return {
        label: (PROV[e] && PROV[e].name) || e,
        data: H.map(p => (p.detection && p.detection[e] != null) ? Math.round(p.detection[e] * 100) : null),
        solidColor: COLOR[e],
        borderColor: COLOR[e],
        backgroundColor: COLOR[e],
        borderWidth: us ? 4 : 2,
        pointRadius: us ? 4 : 2.5,
        pointHoverRadius: us ? 6 : 4,
        tension: 0.25, spanGaps: true
      };
    }).filter(d => d.data.some(v => v != null));

    // Each line's latest value, labelled at its right end so current standings read
    // without hovering; labels are nudged apart vertically when they'd collide.
    const endLabels = {
      id: 'endLabels',
      afterDatasetsDraw(chart) {
        const ctx = chart.ctx;
        const items = [];
        chart.data.datasets.forEach((ds, i) => {
          const meta = chart.getDatasetMeta(i);
          if (meta.hidden || !meta.data.length) return;
          for (let j = ds.data.length - 1; j >= 0; j--) {
            if (ds.data[j] != null) {
              items.push({ x: meta.data[j].x, y: meta.data[j].y, val: ds.data[j], color: ds.solidColor, bold: ds.borderWidth >= 3 });
              break;
            }
          }
        });
        items.sort((a, b) => a.y - b.y);
        for (let i = 1; i < items.length; i++) {
          if (items[i].y - items[i - 1].y < 13) items[i].y = items[i - 1].y + 13;
        }
        ctx.save();
        ctx.textBaseline = 'middle';
        items.forEach(it => {
          ctx.font = (it.bold ? '700 ' : '600 ') + '11px system-ui, sans-serif';
          ctx.fillStyle = it.color;
          ctx.fillText(it.val + '%', it.x + 7, it.y);
        });
        ctx.restore();
      }
    };

    new Chart(document.getElementById('trendChart'), {
      type: 'line',
      data: { labels, datasets },
      plugins: [endLabels],
      options: {
        responsive: true, maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        layout: { padding: { right: 46, left: 6 } },
        scales: {
          y: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' }, title: { display: true, text: 'Catch rate' } }
        },
        plugins: {
          // Chart.js defaults to a 40px line-style box per entry, which pushes
          // eight engines onto three rows and eats the chart's height. Small
          // circular swatches keep the whole field on one or two rows.
          legend: {
            position: 'bottom',
            labels: { usePointStyle: true, pointStyle: 'circle', boxWidth: 8, boxHeight: 8, padding: 12, font: { size: 11 } }
          },
          tooltip: {
            itemSort: (a, b) => b.parsed.y - a.parsed.y,
            callbacks: { label: c => `${c.dataset.label}: ${c.parsed.y}%` }
          }
        }
      }
    });
  })();
  </script>
  <p class="fig-note">Fig. 6 — Catch rate per recorded run, all {{ providers | bySlot | length }} engines. Each run draws a fresh cohort from the feeds, so movement between points is the cohort changing as much as the engines; the series starts at the 2026-07-09 pipeline overhaul, before which a materially different stack was measured.</p>
  {%- else %}
  <div class="note">Historical trend is collecting. Each recorded run appends a snapshot; the line chart appears once there are at least two.</div>
  {%- endif %}

  <details class="method" id="methodology">
    <summary>Methodology</summary>
    <div class="method-body">
      <ul>
        <li><strong>Known-bad</strong> packages are pulled from live threat feeds. Independent feeds are trusted as-is — a bogus listing just makes every engine miss it equally. But a listing from a feed that is <em>also a contestant</em> (Socket, Aikido Malware, GuardDog by Datadog, SafeDep, VT) is kept only when an <em>independent</em> engine corroborates it, so no one is credited for its own possibly-spurious self-report. Atomdrift's own verdicts are held to the same bar and never seed the cohort.</li>
        <li><strong>Freshness</strong> is the point: every sample is drawn from the last 48 hours of feed activity, keeping the cohort zero-day. The malware age quoted up top is measured per sample from its first sighting in a public feed to scan time{% if battle.malware_age %} — this run: {{ battle.malware_age.mean_hours | round(0) }}h mean, {{ battle.malware_age.median_hours | round(0) }}h median, {{ battle.malware_age.max_hours | round(0) }}h max across {{ battle.malware_age.n }} samples{% endif %}.</li>
        <li><strong>Presumed-good</strong> packages are drawn from the freshest 48 hours of the open-source firehose: curated good feeds, newly-published packages nobody has reported, and packages a contestant's own feed has flagged <em>solo</em> (kept in so that vendor's false positives stay measurable — a corroborated report relabels the sample bad and removes it). Samples from independent malware registries never enter this pool. Any flag against a presumed-good package, <em>hostile or suspicious</em>, is a false positive.</li>
        <li><strong>Adjudication:</strong> presumed-good is provisional — threat feeds corroborate malware days after publication. Every pick is re-checked against the label database on later runs: one that turns out to be malware is retroactively removed from that run's false-positive rates, and any engine that flagged it at scan time is credited with an <em>early detection</em> — it beat the feed consensus, and isn't scored as a false alarm for it.</li>
        <li>Each engine's native severity is normalised to five tiers — <em>hostile</em>, <em>suspicious</em>, <em>benign</em> (analyzed, nothing found), <em>no data</em> (the engine has no record of the sample — clean only by absence), <em>unsupported</em>. A sample is <strong>caught</strong> (on known-bad) or a <strong>false alarm</strong> (on presumed-good) when it's flagged <em>hostile or suspicious</em>; the bars stack the two shades, darker for hostile. Anchored to the right of every bar: a red share for samples the engine <em>errored</em> on (hover it for the failures), then a light-grey share for what it can't scan.</li>
        <li><strong>The denominator is the whole cohort</strong>, identical for every engine: once a sample is in, everyone got a shot at it, so a skip (unsupported ecosystem or file type), an error, or "no record of this package" all count the same as a miss. Rates are therefore comparable across engines but understate a narrow engine <em>within its own scope</em> — read them next to the coverage panel, which is exactly where that scope is measured.</li>
        <li>This is <strong>preliminary</strong>: the corpus is small and refreshed continuously, and the known-bad set is still being widened. Numbers will move.</li>
      </ul>
      {%- if battle.versions %}
      <p class="method-versions"><strong>Engine versions:</strong> {% for k, v in battle.versions %}{% if not loop.first %} · {% endif %}{{ providers[k].name or k }} {{ v }}{% endfor %} <span class="audit-note">(locally-run engines; {% for p in providers | bySlot | selectattr("hosted") %}{{ p.name }}{% if not loop.last %}, {% endif %}{% endfor %} are hosted services queried live, so they carry no pinned version; OSV/OSM are live feeds)</span></p>
      {%- endif %}
    </div>
  </details>

  {%- set badSamples = battle.samples | where("label", "bad") -%}
  {%- set goodSamples = battle.samples | where("label", "good") -%}
  {%- set cohortBad = badSamples | whereUnset("excluded") -%}
  <details class="audit">
    <summary>Reference data — {{ cohortBad | length }} known-malware + {{ goodSamples | length }} known-good files, scanned {{ battle.generated_at | dateDisplay }}</summary>

    <h4 class="audit-h"><span class="lab-bad">●</span> Known malware <span class="audit-note">— pulled from threat feeds and corroborated; every detection benchmark number comes from these</span></h4>
    {{ auditTable(cohortBad, battle.detection.leaderboard) }}

    <h4 class="audit-h"><span class="lab-good">●</span> Presumed good <span class="audit-note">— fresh releases with no corroborated malware report; any flag here is a provisional false positive, re-adjudicated as labels catch up</span></h4>
    {{ auditTable(goodSamples, battle.detection.leaderboard) }}

    <h4 class="audit-h">Coverage gaps <span class="audit-note">— what each engine couldn't analyze: whole packages skipped for an unsupported ecosystem, or file types it can't read within a supported one</span></h4>
    <div class="audit-wrap">
      <table class="audit-table">
        <thead><tr><th>Provider</th><th>Skipped ecosystems</th><th>Unscannable file types</th></tr></thead>
        <tbody>
        {%- for c in battle.samples | coverageBoard(providers, battle.ascan_types, battle.detection.leaderboard) %}
          {%- set g = battle.samples | coverageGaps(c.scanner, battle.ascan_types) %}
          <tr>
            <td class="prov{% if c.scanner == 'ascan' %} us{% endif %}">{{ c.name }}</td>
            <td>{% if g.ecoMissed | length %}{% for pair in g.ecoMissed %}{{ pair[0] }} ({{ pair[1] }} file{{ "s" if pair[1] != 1 }}){% if not loop.last %}, {% endif %}{% endfor %}{% else %}<span class="tier-na">-</span>{% endif %}</td>
            <td>{% if g.typeMissed | length %}{% for pair in g.typeMissed %}{{ pair[0] }} ({{ pair[1] }} file{{ "s" if pair[1] != 1 }}){% if not loop.last %}, {% endif %}{% endfor %}{% else %}<span class="tier-na">-</span>{% endif %}</td>
          </tr>
        {%- endfor %}
        </tbody>
      </table>
    </div>
  </details>

</div>
