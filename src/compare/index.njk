---
layout: base.njk
title: Compare
permalink: /compare/
description: Compare Atomdrift with other scanners on 30 days of live zero-day malware and known-good samples. Explore detection and false positives at different sensitivity settings.
---
<link rel="stylesheet" href="/assets/css/compare.css">

{% macro rows(cohort) -%}
  {% for row in cohort.rows -%}
  <tr{% if row.key == 'ascan' %} class="own"{% endif %}>
    <th scope="row">{{ row.name }}</th>
    <td class="detection"{% if row.breakdown %} title="{{ row.breakdown }}"{% endif %}>
      <div class="measure">
        <span class="track" aria-hidden="true">
          {% if row.hostile %}<i class="hostile" style="width:{{ row.hostile }}%"></i>{% endif %}
          {% if row.suspicious %}<i class="suspicious" style="width:{{ row.suspicious }}%"></i>{% endif %}
          {% if row.errors %}<i class="error" style="width:{{ row.errors }}%"></i>{% endif %}
        </span>
        <span class="rate">{{ (row.hostile + row.suspicious) | pct1 }}%</span>
      </div>
    </td>
    <td>
      <span class="rate">{% if row.falsePositive == null %}—{% else %}{{ row.falsePositive | pct1 }}%{% endif %}</span>
      {% if cohort.good %}<small class="judged">{{ row.judged }}/{{ cohort.good }} judged</small>{% endif %}
    </td>
  </tr>
  {%- endfor %}
{%- endmacro %}

{% macro counts(cohort) -%}
  {{ cohort.bad }} malware · {{ cohort.good }} known-good
{%- endmacro %}

<div class="main-full scoreboard" id="compare-scoreboard">
  <div class="scoreboard-header">
    <div>
      <h1>Zero-day detection</h1>
      {% if scoreboard.meanAge != null %}<p class="sample-age"><strong>{{ scoreboard.meanAge | pct1 }} h</strong> average malware age at scan</p>{% endif %}
      <p class="benchmark-period">{% if scoreboard.days %}{{ scoreboard.days }} days · {% endif %}{{ scoreboard.dateRange }} · {{ scoreboard.runs }} runs</p>
    </div>
    {% if scoreboard.ecosystems | length %}
    <label for="compare-ecosystem">Ecosystem
      <select id="compare-ecosystem">
        <option value="all">All ecosystems</option>
        {% for ecosystem in scoreboard.ecosystems %}<option value="{{ loop.index }}">{{ ecosystem.name }}</option>{% endfor %}
      </select>
    </label>
    {% endif %}
  </div>

  <p class="sample-count" id="compare-count" aria-live="polite">{{ counts(scoreboard.all) }}</p>
  <table class="scores" aria-label="Scanner benchmark" aria-describedby="compare-count">
    <thead><tr><th scope="col">Engine</th><th scope="col">Malware detected</th><th scope="col">False positives<span class="scope">Hostile only</span></th></tr></thead>
    <tbody>{{ rows(scoreboard.all) }}</tbody>
  </table>
  {% if scoreboard.ecosystems | length %}
    <template data-cohort="all" data-count="{{ counts(scoreboard.all) }}"><table><tbody>{{ rows(scoreboard.all) }}</tbody></table></template>
    {% for ecosystem in scoreboard.ecosystems %}
      <template data-cohort="{{ loop.index }}" data-count="{{ counts(ecosystem) }}"><table><tbody>{{ rows(ecosystem) }}</tbody></table></template>
    {% endfor %}
  {% endif %}
  <div class="legend" aria-label="Malware verdicts">
    <span><i class="hostile"></i>Hostile</span><span><i class="suspicious"></i>Suspicious</span><span><i class="error"></i>Error</span>
  </div>

  {% if scoreboard.runs > 1 %}
  <section class="comparison-section" aria-labelledby="compare-trend">
    <header class="section-heading">
      <div>
        <h2 id="compare-trend">Run by run</h2>
        <p>Malware detected · all ecosystems</p>
      </div>
      <label for="compare-peer">Compare with
        <select id="compare-peer">
          {% for key, name in scoreboard.chart.labels %}{% if key != 'ascan' %}
          <option value="{{ key }}"{% if key == 'malcontent' %} selected{% endif %}>{{ name }}</option>
          {% endif %}{% endfor %}
        </select>
      </label>
    </header>
    <div class="legend trend-legend"><span><i class="atomdrift"></i>Atomdrift</span><span><i class="peer"></i><span class="peer-name"></span></span></div>
    <svg class="trend-plot" role="img" aria-label="Per-run malware detection rates"></svg>
  </section>
  {% endif %}

  {% if scoreboard.chart.sensitivity.ascan | length and scoreboard.chart.sensitivity.virustotal | length %}
  <section class="comparison-section" aria-labelledby="compare-sensitivity">
    <header class="section-heading"><div>
      <h2 id="compare-sensitivity">Tunable Sensitivity - Detection vs False positives</h2>
      <p>Hostile verdicts · all ecosystems</p>
    </div></header>
    <svg class="sensitivity-plot" role="img" aria-label="Malware detection versus false positives at measured sensitivity settings"></svg>
    <div class="sensitivity-controls">
      {% for key, name in scoreboard.chart.labels %}{% if key == 'ascan' or key == 'virustotal' %}
      <div class="sensitivity-control {{ key }}" data-engine="{{ key }}">
        <label for="sensitivity-{{ key }}"><i aria-hidden="true"></i>{{ name }}</label>
        <output for="sensitivity-{{ key }}"></output>
        <input id="sensitivity-{{ key }}" type="range" min="0" step="1" aria-label="{{ name }} sensitivity">
        <div class="sensitivity-ends"><span></span><span></span></div>
      </div>
      {% endif %}{% endfor %}
    </div>
  </section>
  {% endif %}
</div>

<script type="application/json" id="compare-chart-data">{{ scoreboard.chart | dump | safe }}</script>
<script src="/assets/js/compare.js" defer></script>
