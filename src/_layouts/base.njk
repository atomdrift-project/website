<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - The Atomdrift Project</title>
  <meta name="description" content="{{ description or 'Open-source tools for software supply chain security. Atomic-level analysis of binaries and source code.' }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }} - The Atomdrift Project">
  <meta property="og:description" content="{{ description or 'Open-source tools for software supply chain security. Atomic-level analysis of binaries and source code.' }}">

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='0.9em' font-size='90'>%E2%9A%9B</text></svg>">

  <link rel="alternate" type="application/atom+xml" title="Atomdrift News" href="/feed.xml">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>

  <div class="site-header">
    <div class="header-inner">
      <div class="logo-block">
        <a href="/">
          <img class="atomdrift-logo" src="/assets/images/atomdrift.svg" alt="atomdrift">
          <div class="logo-text">
            <span class="logo-tagline">Open-source malware detection for the modern software supply chain</span>
          </div>
        </a>
      </div>
      <div class="header-links">
        <a href="https://codeberg.org/atomdrift" target="_blank">Codeberg</a>
        <a href="https://lab.atomdrift.org/" class="hl" target="_blank">Lab</a>
      </div>
    </div>
  </div>

  <div class="toxic-stripe"></div>

  <div class="nav">
    <div class="nav-inner">
      <a href="/"{% if page.url == "/" %} class="active"{% endif %}>Home</a>
      <a href="/projects/"{% if page.url == "/projects/" or page.url == "/cleave/" or page.url == "/stng/" or page.url == "/litmus/" or page.url == "/xgboost-native/" %} class="active"{% endif %}>Projects</a>
      <a href="/news/"{% if page.url and page.url.startsWith("/news") %} class="active"{% endif %}>News</a>
    </div>
  </div>

  <main>
    {{ content | safe }}
  </main>

  <div class="site-footer">
    <div class="footer-inner">
      <span>&copy; 2026 The Atomdrift Project</span>
    </div>
  </div>

</body>
</html>
