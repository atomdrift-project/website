<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - The Atomdrift Project</title>
  <meta name="description" content="{{ description or 'Open-source, offline supply-chain attack detection for the AI age. Across binaries, scripts, and source — Apache 2.0.' }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }} - The Atomdrift Project">
  <meta property="og:description" content="{{ description or 'Open-source, offline supply-chain attack detection for the AI age. Across binaries, scripts, and source — Apache 2.0.' }}">

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='0.9em' font-size='90'>%E2%9A%9B</text></svg>">

  <link rel="alternate" type="application/atom+xml" title="Atomdrift News" href="/feed.xml">
  <link rel="alternate" type="application/atom+xml" title="Atomdrift Discoveries" href="/discoveries/feed.xml">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>

  <div class="site-header">
    <div class="header-inner">
      <div class="logo-block">
        <a href="/">
          <svg class="atom-logo" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <circle cx="50" cy="50" r="6" fill="#3b82f6"/>
            <ellipse cx="50" cy="50" rx="38" ry="14" fill="none" stroke="#0a0a0a" stroke-width="1.5" transform="rotate(-30 50 50)"/>
            <ellipse cx="50" cy="50" rx="38" ry="14" fill="none" stroke="#0a0a0a" stroke-width="1.5" transform="rotate(30 50 50)"/>
            <ellipse cx="50" cy="50" rx="38" ry="14" fill="none" stroke="#0a0a0a" stroke-width="1.5" transform="rotate(90 50 50)"/>
            <circle cx="18" cy="28" r="3.5" fill="#d0ff00"/>
            <circle cx="82" cy="28" r="3.5" fill="#d0ff00"/>
            <circle cx="50" cy="88" r="3.5" fill="#d0ff00"/>
          </svg>
          <div class="logo-text">
            <span class="logo-name">atom<span class="logo-accent">drift</span></span>
            <span class="logo-tagline">Open-source, offline supply-chain attack detection for the AI age</span>
          </div>
        </a>
      </div>
      <div class="header-links">
        <a href="https://codeberg.org/atomdrift" target="_blank">Codeberg</a>
        <a href="https://lab.atomdrift.org/" class="hl" target="_blank">Lab</a>
      </div>
    </div>
  </div>

  <div class="toxic-stripe"></div>

  <div class="nav">
    <div class="nav-inner">
      <a href="/"{% if page.url == "/" %} class="active"{% endif %}>Home</a>
      <a href="/news/"{% if page.url and page.url.startsWith("/news") %} class="active"{% endif %}>News</a>
      <a href="/discoveries/"{% if page.url and page.url.startsWith("/discoveries") %} class="active"{% endif %}>Discoveries</a>
      <a href="/projects/"{% if page.url == "/projects/" or page.url == "/cleave/" or page.url == "/stng/" or page.url == "/litmus/" or page.url == "/xgboost-ars/" or page.url == "/azoth/" %} class="active"{% endif %}>Projects</a>
      <a href="/support/"{% if page.url == "/support/" %} class="active"{% endif %}>Support</a>
    </div>
  </div>

  <main>
    {{ content | safe }}
  </main>

  <div class="site-footer">
    <div class="footer-inner">
      <span>&copy; 2026 The Atomdrift Project</span>
    </div>
  </div>

</body>
</html>
