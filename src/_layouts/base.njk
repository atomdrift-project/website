<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - The Atomdrift Project</title>
  <meta name="description" content="{{ description or 'Open-source, local-first supply-chain attack detection across binaries, packages, scripts, and source — Apache 2.0.' }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }} - The Atomdrift Project">
  <meta property="og:description" content="{{ description or 'Open-source, local-first supply-chain attack detection across binaries, packages, scripts, and source — Apache 2.0.' }}">

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20100%20100'%3E%3Ctext%20y='.9em'%20font-size='90'%3E%E2%9A%9B%3C/text%3E%3C/svg%3E">

  <link rel="alternate" type="application/atom+xml" title="Atomdrift News" href="/feed.xml">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header">
    <div class="header-inner">
      <div class="logo-block">
        <a href="/">
          <svg class="atom-logo" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <circle cx="50" cy="50" r="6" fill="#3b82f6"/>
            <ellipse cx="50" cy="50" rx="38" ry="14" fill="none" stroke="#0a0a0a" stroke-width="1.5" transform="rotate(-30 50 50)"/>
            <ellipse cx="50" cy="50" rx="38" ry="14" fill="none" stroke="#0a0a0a" stroke-width="1.5" transform="rotate(30 50 50)"/>
            <ellipse cx="50" cy="50" rx="38" ry="14" fill="none" stroke="#0a0a0a" stroke-width="1.5" transform="rotate(90 50 50)"/>
            <circle cx="18" cy="28" r="3.5" fill="#d0ff00"/>
            <circle cx="82" cy="28" r="3.5" fill="#d0ff00"/>
            <circle cx="50" cy="88" r="3.5" fill="#d0ff00"/>
          </svg>
          <div class="logo-text">
            <span class="logo-name">atom<span class="logo-accent">drift</span></span>
            <span class="logo-tagline">Open-source, local-first supply-chain attack detection</span>
          </div>
        </a>
      </div>
      <div class="header-links">
        <a href="https://github.com/atomdrift-project" target="_blank" rel="noopener">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a>
        <a href="https://install.atomdrift.org/" class="install-link">Install <span aria-hidden="true">&darr;</span></a>
        <a href="https://lab.atomdrift.org/" class="hl" target="_blank" rel="noopener">Lab<span class="visually-hidden"> (opens in a new tab)</span></a>
      </div>
    </div>
  </header>

  <div class="toxic-stripe"></div>

  <nav class="nav" aria-label="Primary">
    <div class="nav-inner">
      <a href="/"{% if page.url == "/" %} class="active" aria-current="page"{% endif %}>Home</a>
      {# Discovery posts keep their /discoveries/ URLs, but they are listed under News now. #}
      <a href="/news/"{% if page.url and (page.url.startsWith("/news") or page.url.startsWith("/discoveries")) %} class="active" aria-current="page"{% endif %}>News</a>
      <a href="/compare/"{% if page.url and page.url.startsWith("/compare") %} class="active" aria-current="page"{% endif %}>Compare</a>
      <a href="/projects/"{% if page.url == "/projects/" or page.url == "/cleave/" or page.url == "/stng/" or page.url == "/scan/" or page.url == "/azoth/" %} class="active" aria-current="page"{% endif %}>Projects</a>
      <a href="/support/"{% if page.url == "/support/" %} class="active" aria-current="page"{% endif %}>Support</a>
    </div>
  </nav>

  <main id="main-content" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span>&copy; 2026 The Atomdrift Project</span>
    </div>
  </footer>

</body>
</html>
