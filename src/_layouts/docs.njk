---
layout: base.njk
---

<div class="main">
  <div class="content docs-content" data-pagefind-body>
    {% include "docs-nav.njk" %}
    <h1>{{ title }}</h1>
    {{ content | safe }}
  </div>

  <aside class="sidebar docs-search">
    <h3>Search the docs</h3>
    <div id="docs-search"></div>
    <p class="docs-search-hint">Searches every tool's documentation.</p>
  </aside>
</div>

{#- Pagefind search index is generated at build time into /pagefind/. -#}
<link rel="stylesheet" href="/pagefind/pagefind-ui.css">
<script src="/pagefind/pagefind-ui.js"></script>
<script>
  window.addEventListener("DOMContentLoaded", function () {
    if (window.PagefindUI) {
      new PagefindUI({ element: "#docs-search", showImages: false, showSubResults: true });
    }
  });
</script>

{#- Mermaid is loaded only when a diagram is present on the page. -#}
<script type="module">
  if (document.querySelector(".mermaid")) {
    const { default: mermaid } = await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
    mermaid.initialize({ startOnLoad: true, theme: "neutral" });
  }
</script>
